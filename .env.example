# Copy this file to `.env` and fill in your real key. `.env` is git-ignored.

# Backend
PORT=4000

# DeepSeek (OpenAI-compatible API)
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Offline dev: set true to return a canned summary without calling DeepSeek
MOCK=false

# Max transcript characters sent to the LLM (cost/context safety)
TRANSCRIPT_CHAR_LIMIT=12000

# Where transcripts come from:
#   library — read YouTube's captions directly. Free, and the default for local runs.
#   api     — use a hosted transcript provider. Needed when deployed, because YouTube
#             blocks caption requests from cloud/datacenter IP ranges.
# Leave this unset locally; setting SUPADATA_API_KEY alone switches to "api".
# TRANSCRIPT_PROVIDER=api
# SUPADATA_API_KEY=your-key-here
