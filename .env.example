# Copy this file to `.env` and fill in your real key. `.env` is git-ignored.

# Backend
PORT=4000

# DeepSeek (OpenAI-compatible API)
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Offline dev: set true to return a canned summary without calling DeepSeek
MOCK=false

# Max transcript characters sent to the LLM (cost/context safety)
TRANSCRIPT_CHAR_LIMIT=12000
